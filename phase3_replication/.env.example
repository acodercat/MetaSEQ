# Copy to .env and fill in. Never commit .env.
# Read-only credentials: agent code runs in-process against this database.
METASEQ_HK_DATABASE_URL=postgresql+psycopg://readonly_user@host:5432/hkgai_air

# Only needed by tasks whose queries name an address.
METASEQ_GOOGLE_PLACES_API_KEY=replace-me

# Optional overrides (defaults shown).
# METASEQ_MODELS_TOML=models.toml
# METASEQ_RESULTS_DIR=results
